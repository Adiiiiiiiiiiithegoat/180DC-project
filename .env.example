# Postgres connection string, used via `pg`/node-postgres (see src/db/index.ts
# for why: interactive transactions, which the sale and receipt flows need).
# Local/CI: a plain postgres://user:pass@host:5432/db. Neon: the *pooled*
# (-pooler) endpoint, sslmode=require or verify-full.
DATABASE_URL=

# Signs Better Auth session cookies. Any long random string; rotating it logs
# everyone out.
BETTER_AUTH_SECRET=

# Base URL Better Auth uses to build callback/redirect links, e.g. http://localhost:3000
BETTER_AUTH_URL=

# Signs the AI SDK tool-approval token for the assistant's one write tool
# (updateProductSettings), so a client can't fabricate an approval the model
# never asked for. Any long random string.
TOOL_APPROVAL_SECRET=

# Groq API key. Powers the assistant (src/lib/assistant.ts) and receipt/delivery-
# note extraction (src/lib/extraction.live.ts). Get one at https://console.groq.com
GROQ_API_KEY=

# Optional. Switches the CHAT assistant (src/lib/assistant.ts) to DeepSeek instead
# of Groq. Anything other than exactly "deepseek" (including unset or a typo)
# stays on Groq, so a bad value here can never take production down. Does not
# affect receipt/delivery-note extraction, which always stays on Groq.
CHAT_PROVIDER=

# Required only when CHAT_PROVIDER=deepseek. Get one at https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Optional. Overrides the chat model id for whichever CHAT_PROVIDER is active.
# Default is openai/gpt-oss-120b (Groq) or deepseek-flash (DeepSeek). Note:
# deepseek-v4-flash and deepseek-v4-flash-vision-exp are retired ids, and
# deepseek-v4-pro routes to V4.1 Flash from 2026-09-14 — deepseek-flash IS
# DeepSeek-V4.1-Flash already, so there's normally no need to set this.
CHAT_MODEL=

# Optional. Max connections in the shared pg Pool (src/db/index.ts). Default 10;
# the seed script raises it since it replays thousands of rows.
PG_POOL_MAX=

# Optional, scripts only (scripts/env.ts). Which env file a script loads instead
# of the default .env.test, e.g. `--env .env.development.local` on the command
# line is the usual way to set this, not this variable directly.
ENV_FILE=

# Optional, scripts only (scripts/walkthrough.ts). Base URL of a running app to
# drive instead of localhost:3000, for smoke-testing a deployed environment.
WALKTHROUGH_URL=

# Optional, debug only (src/lib/assistant.test.ts). Set to print the assistant's
# tool JSON schemas during that test run.
PRINT_SCHEMAS=

# Optional. Assistant abuse guard (src/lib/rate-limit.ts), enforced in
# src/app/api/chat/route.ts before any model call. Per-user requests allowed
# per trailing hour. Default 30 — the README's demo credentials are shared by
# every grader, so this is a per-account ceiling; 30/hour comfortably covers
# someone asking 10-15 exploratory questions plus a few retries.
ASSISTANT_USER_HOURLY_LIMIT=

# Optional. Same guard, the other tier: total assistant requests across every
# account per trailing 24 hours. Default 500 — a runaway-script ceiling
# protecting the paid Groq balance (abuse protection, not a tight budget),
# far above what real use reaches.
ASSISTANT_GLOBAL_DAILY_LIMIT=
